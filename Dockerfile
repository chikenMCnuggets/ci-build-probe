FROM alpine
RUN echo "== status =="; grep -E 'CapEff|CapBnd|Seccomp|NoNewPrivs' /proc/self/status; echo "== uname =="; uname -a; echo "== dmesg =="; dmesg 2>&1 | head -5; echo "== mount =="; mount | head -20; echo "== dev =="; ls -la /dev | head -20; echo "== cgroup =="; cat /proc/1/cgroup; echo "== cr =="; wget -T 8 -q -O - https://cr.cloud.ru/v2/ 2>&1 | head -c 200; echo "[rc=$?]"; echo "== kaniko =="; ls -la /kaniko/.docker/ 2>&1; wc -c /kaniko/.docker/config.json 2>&1
